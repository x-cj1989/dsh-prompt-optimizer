{
  "name": "@local/dsh-prompt-optimizer",
  "version": "1.5.3",
  "private": true,
  "type": "module",
  "description": "Adds an Optimize button to the DeepSeek Harness composer: it rewrites the draft into a structured professional prompt and shows a before/after diff before anything is written back.",
  "license": "MIT",
  "author": "x-cj1989",
  "homepage": "https://github.com/x-cj1989/dsh-prompt-optimizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-cj1989/dsh-prompt-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/x-cj1989/dsh-prompt-optimizer/issues"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "prompt", "prompt-engineering"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check lib/rewrite.js && node --check lib/handler.js && node --check lib/settings.js",
    "verify": "npm run check && npm test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "lib", "cordis.patch.yml", "locale/*.json", "icon.svg", "CHANGELOG.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}